# Copy to .env.local and fill in. Never commit real keys.
MODEL_PROVIDER=gemini            # gemini | groq | mock (mock = development only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite      # chosen on the dev set; see DEVLOG
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_THINKING=low              # low | medium | high | default
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct   # confirm a vision + JSON-schema model on console.groq.com
RATE_LIMIT_PER_HOUR=20
